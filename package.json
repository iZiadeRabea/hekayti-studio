{
  "name": "hekayti-studio",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.2 <23 || >=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/app/*.test.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "desktop": "electron apps/desktop",
    "package:win": "npm run build && electron-builder --config apps/desktop/electron-builder.json --win --x64",
    "smoke": "node scripts/desktop-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
